rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    function isSoham(businessId) {
      return signedIn()
        && request.auth.uid == 'mPGgPnM9mgf4T1TjWKVhII6bONZ2'
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == '7s53P27wzQWuTYCbDxvCSlIM58n2';
    }

    function canOperate(businessId) {
      return isOwner(businessId) || isSoham(businessId);
    }

    function validId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /businesses/{businessId} {
      allow get: if canOperate(businessId);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
  && validId(businessId)
  && request.resource.data.ownerId == request.auth.uid;

allow update: if isOwner(businessId)
  && validId(businessId)
  && request.resource.data.ownerId == resource.data.ownerId;

allow delete: if false;
      match /{collection}/{itemId} {
        allow read, write: if canOperate(businessId)
          && collection in [
            'clients',
            'services',
            'staff',
            'appointments',
            'cashMovements',
            'giftCards',
            'resources'
          ]
          && validId(itemId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
